# 占位示例。把本文件复制为 .env 后再填写。不要把真实密钥、数据库口令、
# 预览共享秘密或私人资料写进仓库。

VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/langao
KEY_ENCRYPTION_SECRET=replace-with-a-different-long-random-string
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailbox@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=mailbox@example.com
AUTH_IP_HEADER=x-real-ip
